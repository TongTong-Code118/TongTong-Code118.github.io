$brand-color = #ff6a3d;
$body-bg-color = #f4f4f4;

.site-brand-container {
  background: #222;
}

.site-title, .site-subtitle {
  color: #fff;
}

.post-block, .sidebar-inner {
  box-shadow: 0 2px 8px rgba(0, 0, 0, .10);
}

.post-title {
  font-weight: 500;
}

.post-body {
  font-size: 16px;
  line-height: 1.9;
}

.post-body h2 {
  border-bottom: 1px solid #eee;
  padding-bottom: .35em;
}

a, .post-toc .nav .active > a {
  color: #ff6a3d;
}
